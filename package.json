{
  "name": "project-nidus-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node scripts/free-dev-ports.mjs && turbo dev --filter=@nidus/platform-app --filter=@nidus/simulator-app",
    "dev:all": "node scripts/free-dev-ports.mjs && turbo dev --concurrency=30",
    "dev:platform": "node scripts/free-dev-ports.mjs && turbo dev --filter=@nidus/platform-app",
    "dev:simulator": "node scripts/free-dev-ports.mjs && turbo dev --filter=@nidus/simulator-app",
    "build": "turbo build",
    "build:platform": "turbo build --filter=@nidus/platform-app",
    "build:simulator": "turbo build --filter=@nidus/simulator-app",
    "build:planning-hub": "turbo build --filter=@nidus/planning-hub",
    "dev:planning-hub": "turbo dev --filter=@nidus/planning-hub",
    "new-module": "node scripts/new-module.js",
    "scaffold:modules": "node scripts/v731-scaffold-all-modules.mjs",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "watch:docs": "node scripts/watch-documentation.js",
    "sync:docs": "node scripts/sync-documentation.js",
    "lint:boundaries": "eslint -c packages/eslint-config/boundaries.js apps/platform/src/pages/platform-app apps/platform/src/pages/app apps/simulator/src/pages/simulator apps/simulator/src/pages/sim apps/simulator/src/services/sim packages",
    "audit:cross-domain": "node scripts/audit-cross-domain-imports.mjs",
    "audit:v729": "node scripts/audit-v729-completion.mjs",
    "validate:menus": "node scripts/validate-menu-registry.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@originjs/vite-plugin-federation": "^1.3.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/ui": "^4.0.15",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "pg": "^8.16.0",
    "turbo": "^2.5.4",
    "vitest": "^4.0.15"
  }
}
